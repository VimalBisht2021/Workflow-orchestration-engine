{
  "title": "Queue Health",
  "tags": ["orchestration", "queue"],
  "timezone": "browser",
  "schemaVersion": 16,
  "version": 0,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Queue Depth",
      "targets": [
        {
          "expr": "queue_depth",
          "legendFormat": "Tasks"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Queue Wait Latency (p95)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(task_queue_wait_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 Wait Time"
        }
      ]
    }
  ]
}
