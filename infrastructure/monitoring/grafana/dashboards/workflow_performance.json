{
  "title": "Workflow Performance",
  "tags": ["orchestration", "performance"],
  "timezone": "browser",
  "schemaVersion": 16,
  "version": 0,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Workflow Duration (p95)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(workflow_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 Duration"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Task Duration (p95)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(task_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 Task Duration"
        }
      ]
    }
  ]
}
