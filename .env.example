# PostgreSQL Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/workflow_db?schema=public"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379

# DTP Configuration
DTP_BASE_URL="http://localhost:4000"
DTP_API_KEY="dtp-secret-api-key"

# WOE Webhook URL (used by DTP to send events back)
WOE_WEBHOOK_URL="http://localhost:3000/api/webhooks/tasks/events"
WEBHOOK_SECRET="secret"

# Dashboard
NEXT_PUBLIC_API_URL="http://localhost:3000"
